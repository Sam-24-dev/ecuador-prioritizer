{
  "name": "ecuador-prioritizer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "check:csv-export": "node tests/check-csv-export.mjs",
    "check:txt-import": "node tests/check-txt-import.mjs",
    "check:ui-copy": "node tests/check-ui-copy.mjs",
    "check:wait-context": "node tests/check-wait-context.mjs",
    "check:url-import": "node tests/check-url-import-api.mjs && node tests/check-url-import-batch.mjs && node tests/check-url-import-ui.mjs && node tests/check-url-import-ux.mjs",
    "check:client-timeout": "node --experimental-strip-types tests/client-timeout.test.ts && node tests/check-client-timeout.mjs",
    "check:support-reference-id": "node --experimental-strip-types tests/support-reference-id.test.ts",
    "check:url-extraction-errors": "node --experimental-strip-types tests/url-extraction-errors.test.ts",
    "check:e2e": "playwright test --config=playwright.config.mjs",
    "preview": "vite preview",
    "check:security-headers": "node tests/check-security-headers.mjs",
    "check:https-redirect": "node --experimental-strip-types tests/https-redirect.test.ts",
    "check:seo-crawl-files": "node tests/check-seo-crawl-files.mjs",
    "check:favicon": "node tests/check-favicon.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}
